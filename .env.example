# Copy to .env and set your keys

# Required in production. For local dev, a default is used if unset.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-64-char-hex-secret

# Recommended for hosted deploys
# FLASK_ENV=production
# SESSION_COOKIE_SECURE=1

# ----- AI provider: set ONE key (or more; first one wins unless AI_PROVIDER is set) -----
# PythonAnywhere free accounts may not be able to reach all third-party APIs.
# Leave these unset if you only need the core Flask + SQLite app there.
# The chosen provider drives task generation, answer explanations and writing
# feedback. Embeddings for the RAG corpus are separate — see RAG_EMBEDDING_BACKEND.

# Option 1 — DeepSeek (paid, OpenAI-compatible): https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# Optional self-hosted or proxy endpoint (default: https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Option 2 — OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# Option 2 — Groq (FREE, fast): https://console.groq.com
# Option 3 — Groq (FREE, 14 400 req/day, fast): https://console.groq.com → "Create API Key"
# GROQ_API_KEY=gsk_your-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# If you use Groq, unset OPENAI_BASE_URL (e.g. local proxy) or the app will force Groq's URL.

# Option 4 — Google AI Studio / Gemini (free tier): https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=your-google-ai-key
# GOOGLE_AI_MODEL=gemini-3.5-flash
# Gemini retires models for new accounts and returns 503 when overloaded, so the app
# fails over across several current models automatically.

# Option 5 — Hugging Face Inference API (free tier): https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=hf_your-key-here
# HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# Force a specific provider (optional — unset = first configured key is used)
# Priority when unset: deepseek → openai → groq → google → huggingface
# AI_PROVIDER=deepseek
# AI_PROVIDER=openai
# AI_PROVIDER=groq
# AI_PROVIDER=google
# AI_PROVIDER=huggingface

# Optional: SMTP for password reset emails
# Any SMTP provider works. For Gmail, create an App Password:
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com   # defaults to SMTP_USER if unset

# Optional: server port (default: 3000)
# PORT=3000

# ----- Logging -----
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO, or DEBUG if
# FLASK_DEBUG is set).
# LOG_LEVEL=INFO
#
# Optional: also write logs to a rotating file (max 1 MB x 4). Relative paths
# resolve inside the project. Recommended on hosts that truncate captured
# stderr on each reload (PythonAnywhere does), so history survives.
# LOG_FILE=logs/fce_trainer.log
#
# Optional: log the full prompt sent to the LLM, and the RAG examples that were
# retrieved and injected. Very verbose, but it is the only way to see exactly
# what the model was asked. Inspect without generating anything using:
#   python -m scripts.preview_prompt --part 1 --topic "..."
# LOG_AI_PROMPTS=1

# Optional: custom SQLite location. Default is ./fce_trainer.db
# Example for PythonAnywhere: /home/YOUR_USERNAME/FCE-Trainer/fce_trainer.db
# DB_PATH=/absolute/path/to/fce_trainer.db

# Optional: RAG example corpus location. Default is ./rag_examples.db
# Kept separate from the main DB so imported (possibly copyrighted) study
# material never reaches the tracked portable_state snapshot. See README.
# RAG_DB_PATH=/absolute/path/to/rag_examples.db

# Optional: RAG embedding backend: auto | local | openai  (default: auto)
#   auto   = local model if fastembed is installed, else OpenAI, else keyword search
#   local  = fastembed (free, offline, no API key) — recommended
#   openai = text-embedding-3-small (needs credits)
# RAG_EMBEDDING_BACKEND=local

# Optional: local embedding model (default: BAAI/bge-small-en-v1.5, 384-dim).
# Changing it requires re-embedding:
#   python -m scripts.rag_manager rebuild-embeddings --all
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional: Gemini embedding settings (used when RAG_EMBEDDING_BACKEND=google).
# RAG_GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# RAG_GOOGLE_EMBEDDING_DIM=768
# Texts per batch request. The free tier is rate/token limited and returns 429
# if batches are too large, so this is deliberately small.
# RAG_GOOGLE_BATCH_SIZE=25

# Optional: Google OAuth for "Connect Google account" on the home page (per-account statistics)
# Create a project in Google Cloud Console and add the redirect URI:
#   https://YOUR_USERNAME.pythonanywhere.com/login/google/authorized
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional: TTS engine
# TTS_ENGINE=edge

# Optional: proctor for mock exam (see proctor/README.md). Default uses ../proctor (wrk/proctor).
# PROCTOR_DIR=../proctor
# PROCTOR_ENABLED=1
# PROCTOR_NAME=My proctor
# When using wrk/proctor: backend and frontend URLs (FCE calls backend and redirects to frontend)
# PROCTOR_BACKEND_URL=http://localhost:8000
# PROCTOR_FRONTEND_URL=http://localhost:5173
# PROCTOR_EXAM_CODE=DEMO
